# ==============================================================================
# ProposalCraft AI Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR ACTUAL CREDENTIALS.
# NEVER COMMIT REAL API KEYS, SECRETS, OR PASSWORDS TO SOURCE CONTROL.

# Application Environment (development | staging | production)
APP_ENV=development

# Database Connection URL
# For local zero-setup dev: sqlite+aiosqlite:///./proposalcraft.db
# For production PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/proposalcraft
DATABASE_URL=sqlite+aiosqlite:///./proposalcraft.db

# JWT Security
# Generate a strong 32+ char secret: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# NVIDIA NIM Hosted Inference API Configuration
# Get your real API key from https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-real-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Tested & verified supported models:
# - meta/llama-3.3-70b-instruct
# - meta/llama-3.1-70b-instruct
# - mistralai/mistral-large-2-instruct
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_TIMEOUT_SECONDS=90
NVIDIA_MAX_RETRIES=3

# Frontend & Backend Origin Configuration
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000

# File Upload Constraints
UPLOAD_MAX_SIZE_MB=10
ALLOWED_EXTENSIONS=txt,pdf,docx

# Server Port
PORT=8000
HOST=0.0.0.0
